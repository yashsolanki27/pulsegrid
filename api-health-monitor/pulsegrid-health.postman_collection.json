        {
          "name": "CRM — Create customer (validation alive check)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"not-an-email\", \"name\": \"\"}"
            },
            "url": {
              "raw": "{{crm_base_url}}/customers",
              "host": ["{{crm_base_url}}"],
              "path": ["customers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"CRM POST /customers with invalid payload returns 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
