{
  "$schema": "https://schema.railway.app/railway-schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "access-control/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'uv run --no-dev uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8002}'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
