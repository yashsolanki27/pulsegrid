# access-control — environment variables
#
# Copy this file to .env and fill in the values before running.
# Never commit .env to version control.
#
# ── Azure AD (Phase 7) ───────────────────────────────────────────────────────
# Required for the real Microsoft login flow. See patterns.md § Azure AD app
# registration for the manual Azure Portal setup steps.

AAD_CLIENT_ID=your-client-id-here
AAD_CLIENT_SECRET=your-client-secret-value-here  # NOT the Secret ID (GUID)
AAD_TENANT_ID=your-tenant-id-here
AAD_REDIRECT_URI=http://localhost:8002/auth/callback

# ── Session ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your-secret-key-here

# ── Service port ─────────────────────────────────────────────────────────────
ACCESS_CONTROL_PORT=8002

# ── Databases ────────────────────────────────────────────────────────────────
# Local dev defaults (Docker Compose DBs):
CRM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crm
ERP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/erp

# Railway production (replace with actual Railway Postgres URL):
# CRM_DATABASE_URL=postgresql+psycopg://user:pass@turntable.proxy.rlwy.net:17746/crm
# ERP_DATABASE_URL=postgresql+psycopg://user:pass@turntable.proxy.rlwy.net:17746/erp

# ── External services ────────────────────────────────────────────────────────
LOGPULSE_URL=https://log-pulse.up.railway.app
CRM_SERVICE_URL=http://localhost:8000
ERP_SERVICE_URL=http://localhost:8001

# ── Guest / demo mode (Phase 8) ──────────────────────────────────────────────
# Set to "true" to enable the /demo-login endpoint.
# Default: false (endpoint returns HTTP 404).
# MUST be false in any deployment with real user data.
# Only enable when databases contain only synthetic seed data.
DEMO_MODE_ENABLED=false
