				},
				{
					"name": "Transition guard: sent → draft (INVALID, expect 422)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"422 Unprocessable — invalid transition sent→draft\", () => pm.response.to.have.status(422));",
									"pm.test(\"detail mentions invalid transition\", () => {",
									"  const detail = pm.response.json().detail;",
									"  pm.expect(detail).to.be.a(\"string\");",
									"  pm.expect(detail).to.include(\"invalid status transition\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"draft\"\n}"
						},
						"url": "{{baseUrl}}/invoices/{{invoice_id}}"
					}
				},
				{
					"name": "Transition guard: sent → paid (VALID, expect 200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK — valid transition sent→paid\", () => pm.response.to.have.status(200));",
									"pm.test(\"status is now paid\", () => pm.expect(pm.response.json().status).to.eql(\"paid\"));"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"paid\"\n}"
						},
						"url": "{{baseUrl}}/invoices/{{invoice_id}}"
					}
				},
				{
					"name": "Transition guard: paid → overdue (terminal, expect 422)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"422 Unprocessable — paid is terminal, no transitions allowed\", () => pm.response.to.have.status(422));",
									"pm.test(\"detail mentions terminal state\", () => {",
									"  const detail = pm.response.json().detail;",
									"  pm.expect(detail).to.be.a(\"string\");",
									"  pm.expect(detail).to.include(\"invalid status transition\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"overdue\"\n}"
						},
						"url": "{{baseUrl}}/invoices/{{invoice_id}}"
					}
				},
				{
					"name": "Delete invoice",
