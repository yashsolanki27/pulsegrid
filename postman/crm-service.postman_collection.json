				{
					"name": "Create customer A",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (!pm.collectionVariables.get(\"customer_a_email\")) {",
									"  pm.collectionVariables.set(\"customer_a_email\", `alice.${Date.now()}@example.com`);",
									"  pm.collectionVariables.set(\"customer_b_email\", `bob.${Date.now()}@example.com`);",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test(\"echoes email and name\", () => {",
									"  pm.expect(body.email).to.eql(pm.collectionVariables.get(\"customer_a_email\"));",
									"  pm.expect(body.name).to.eql(\"Alice\");",
									"});",
									"pm.test(\"has id and created_at\", () => {",
									"  pm.expect(body.id).to.be.a(\"number\");",
									"  pm.expect(body.created_at).to.be.a(\"string\");",
									"});",
									"pm.collectionVariables.set(\"customer_id\", body.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{customer_a_email}}\",\n  \"name\": \"Alice\"\n}"
						},
						"url": "{{baseUrl}}/customers"
					}
				},
				{
					"name": "Create customer B",
					"event": [
						{
							"listen": "test",
							"script": {
