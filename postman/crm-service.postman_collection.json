		"name": "PulseGrid — crm-service",
		"description": "CRUD + edge-case coverage for crm-service implemented endpoints (customers, orders, tickets).\n\nCovers ONLY what is currently built: no ticket severity/status fields, no erp-service integration, no auth, no pagination.\n\nRequests must run in collection order (Newman default) — ids chain via collection variables set by test scripts. Emails are timestamped per run so re-runs are safe even if a previous run's cleanup failed.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000" },
		{ "key": "customer_a_email", "value": "" },
		{ "key": "customer_b_email", "value": "" },
		{ "key": "customer_id", "value": "" },
		{ "key": "customer_b_id", "value": "" },
		{ "key": "order_id", "value": "" },
		{ "key": "ticket_id", "value": "" }
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health check",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/health"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"status ok\", () => pm.expect(pm.response.json()).to.eql({ status: \"ok\" }));"
								]
							}
						}
					]
				}
			]
		},
		{
