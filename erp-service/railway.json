{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "erp-service/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'uv run --no-dev uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8001}'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
