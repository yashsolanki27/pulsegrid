# ─── Phase 7: Access Control (Azure AD) ───────────────────────────────────────
# All variables below are required for access-control/ to start.
# Generate SESSION_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

AAD_CLIENT_ID=your-client-id-here
AAD_CLIENT_SECRET=your-client-secret-here
AAD_TENANT_ID=your-tenant-id-here
AAD_REDIRECT_URI=http://localhost:8002/auth/callback
# Production (Railway): AAD_REDIRECT_URI=https://pulsegrid-dashboard.up.railway.app/auth/callback
SESSION_SECRET_KEY=replace-with-output-of-secrets-token-hex-32
ACCESS_CONTROL_PORT=8002

# ─── Shared DB URLs (also used by reconciliation-job) ─────────────────────────
CRM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crm
ERP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/erp

# ─── LogPulse (also used by reconciliation-job / webhook-receiver) ─────────────
LOGPULSE_URL=https://log-pulse.up.railway.app
